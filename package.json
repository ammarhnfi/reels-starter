{
  "name": "reels-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "setup:tts": "node scripts/setup-tts.mjs",
    "voice": "node scripts/voice.mjs",
    "music": "node scripts/music.mjs",
    "render": "remotion render src/index.ts Video out/video.mp4 --codec=h264 --crf=18 --audio-bitrate=192k",
    "still": "remotion still src/index.ts Video out/still.png --frame=60"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@remotion/cli": "4.0.541",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.6.3"
  }
}
